+/// DG prototype (worktree only, not for merge): deterministic net-order variants selected by
+/// the env var `TOPOR_DG_VARIANT` (0 = `order`), `TOPOR_DG_HARD` = file of `net\tlabelA\tlabelB`
+/// lines (sorted labels) routed first in variant 7. O(m log m).
+pub fn order_variant(conns: &[Connection], bumps: &[u32]) -> Vec<usize> {
+    let v: u32 = std::env::var("TOPOR_DG_VARIANT")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(0);
+    if v == 0 {
+        return order(conns, bumps);
+    }
+    fn mix(mut x: u64) -> u64 {
+        x = x.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        x = (x ^ (x >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        x = (x ^ (x >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        x ^ (x >> 31)
+    }
+    let hard: Vec<bool> = if v == 7 {
+        let set: std::collections::BTreeSet<String> = std::env::var("TOPOR_DG_HARD")
+            .ok()
+            .and_then(|p| std::fs::read_to_string(p).ok())
+            .map(|s| s.lines().map(|l| l.trim_end().to_string()).collect())
+            .unwrap_or_default();
+        conns
+            .iter()
+            .map(|c| {
+                let (a, b) = if c.from.label <= c.to.label {
+                    (&c.from.label, &c.to.label)
+                } else {
+                    (&c.to.label, &c.from.label)
+                };
+                set.contains(&format!("{}\t{}\t{}", c.net, a, b))
+            })
+            .collect()
+    } else {
+        vec![false; conns.len()]
+    };
+    let mut idx: Vec<usize> = (0..conns.len()).collect();
+    idx.sort_by(|&a, &b| {
+        let (ca, cb) = (&conns[a], &conns[b]);
+        let ba = bumps.get(a).copied().unwrap_or(0);
+        let bb = bumps.get(b).copied().unwrap_or(0);
+        let head = bb.cmp(&ba).then(ca.tier.cmp(&cb.tier));
+        let rest = match v {
+            // longer first within width
+            1 => cb.width.cmp(&ca.width).then(cb.est_len.total_cmp(&ca.est_len)),
+            // shorter first, width ignored
+            2 => ca.est_len.total_cmp(&cb.est_len),
+            // seeded shuffle within width
+            3 | 4 => {
+                let s = v as u64 * 0x1234_5678;
+                cb.width
+                    .cmp(&ca.width)
+                    .then(mix(ca.id as u64 ^ s).cmp(&mix(cb.id as u64 ^ s)))
+            }
+            // nets grouped in a seeded net order, shorter first inside the net
+            5 | 6 => {
+                let s = v as u64 * 0x9876_5431;
+                cb.width
+                    .cmp(&ca.width)
+                    .then(mix(ca.net as u64 ^ s).cmp(&mix(cb.net as u64 ^ s)))
+                    .then(ca.est_len.total_cmp(&cb.est_len))
+            }
+            // pour connections after every pad-pad connection, then the default order
+            9 => matches!(ca.to.kind, TermKind::Pour(_))
+                .cmp(&matches!(cb.to.kind, TermKind::Pour(_)))
+                .then(cb.width.cmp(&ca.width))
+                .then(ca.est_len.total_cmp(&cb.est_len)),
+            // first-pass failures first, then the default order
+            7 => hard[b]
+                .cmp(&hard[a])
+                .then(cb.width.cmp(&ca.width))
+                .then(ca.est_len.total_cmp(&cb.est_len)),
+            // narrow first (reverse width), shorter first
+            _ => ca.width.cmp(&cb.width).then(ca.est_len.total_cmp(&cb.est_len)),
+        };
+        head.then(rest).then(ca.net.cmp(&cb.net)).then(ca.id.cmp(&cb.id))
+    });
+    idx
+}
