+/// EXPERIMENT (gate diagnosis): outline as chords with arcs tessellated to sagitta <= 10 um.
+pub(crate) const OUTLINE_SAGITTA_NM: f64 = 10_000.0;
+pub(crate) fn outline_chords(outline: &[Prim]) -> Vec<(Vec2, Vec2)> {
+    let mut out = Vec::new();
+    for p in outline {
+        match p {
+            Prim::Seg(s) => out.push((s.a, s.b)),
+            Prim::Arc(a) => {
+                let n = if a.r > OUTLINE_SAGITTA_NM {
+                    (a.sweep.abs() / (2.0 * (1.0 - OUTLINE_SAGITTA_NM / a.r).acos()))
+                        .ceil()
+                        .max(1.0) as usize
+                } else {
+                    1
+                };
+                let mut prev = a.point_at(0.0);
+                for i in 1..=n {
+                    let q = a.point_at(i as f64 / n as f64);
+                    out.push((prev, q));
+                    prev = q;
+                }
+            }
+        }
+    }
+    out
+}
